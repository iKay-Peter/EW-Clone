<Window x:Class="EW.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="720"
        Width="1180"
        MinHeight="540"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="Import _Songs..." Command="{Binding ImportSongsCommand}" />
        <MenuItem Header="Import _Media..." Command="{Binding ImportMediaCommand}" />
        <MenuItem Header="Import _Presentations..." Command="{Binding ImportPresentationsCommand}" />
        <MenuItem Header="Import _Theme..." Command="{Binding ImportThemeCommand}" />
        <MenuItem Header="Import Service _Intervals..." Command="{Binding ImportServiceIntervalsCommand}" />
        <MenuItem Header="Import Settings..." Command="{Binding ImportSettingsCommand}" />
        <Separator />
        <MenuItem Header="Open Data Folder" Command="{Binding OpenDataFolderCommand}" />
        <Separator />
        <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit" />
      <MenuItem Header="_Live">
        <MenuItem Header="Go Live" Command="{Binding GoLiveCommand}" />
        <MenuItem Header="Next Slide" Command="{Binding NextSlideCommand}" />
        <MenuItem Header="Previous Slide" Command="{Binding PreviousSlideCommand}" />
        <Separator />
        <MenuItem Header="Black" Command="{Binding BlackOutputCommand}" />
        <MenuItem Header="Clear" Command="{Binding ClearOutputCommand}" />
        <MenuItem Header="Logo" Command="{Binding ShowLogoCommand}" />
      </MenuItem>
      <MenuItem Header="_Profiles" />
      <MenuItem Header="_View" />
      <MenuItem Header="_Help" />
    </Menu>

    <ToolBarTray DockPanel.Dock="Top" Background="White">
      <ToolBar>
        <Button Content="Import Songs" Command="{Binding ImportSongsCommand}" />
        <Button Content="Import Media" Command="{Binding ImportMediaCommand}" />
        <Button Content="Import Presentations" Command="{Binding ImportPresentationsCommand}" />
        <Separator />
        <Button Content="Go Live" Command="{Binding GoLiveCommand}" />
        <Button Content="Alerts" Command="{Binding ShowAlertsCommand}" />
        <Button Content="Logo" Command="{Binding ShowLogoCommand}" />
        <Button Content="Black" Command="{Binding BlackOutputCommand}" />
        <Button Content="Clear" Command="{Binding ClearOutputCommand}" />
      </ToolBar>
    </ToolBarTray>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock Text="{Binding Status}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding LibrarySummary}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding ProfileName}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding OutputStatus}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding Version}" />
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Margin="0,0,8,0"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Text="Service Intervals" />
          <TextBlock DockPanel.Dock="Top"
                     Margin="0,4,0,8"
                     Foreground="{StaticResource MutedTextBrush}"
                     Text="Imported from ServiceIntervals.db" />
          <ListBox ItemsSource="{Binding ServiceIntervals}"
                   SelectedItem="{Binding SelectedServiceInterval}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,3">
                  <TextBlock Text="{Binding StartValue, TargetNullValue=Unknown start}" />
                  <TextBlock Foreground="{StaticResource MutedTextBrush}"
                             Text="{Binding EndValue, TargetNullValue=Unknown end}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="1"
              Margin="0,0,8,0"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              Padding="8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top"
                      Margin="0,0,0,8"
                      Orientation="Horizontal">
            <Button MinWidth="82" Content="Go Live" Command="{Binding GoLiveCommand}" />
            <Button MinWidth="74" Margin="6,0,0,0" Content="Alerts" Command="{Binding ShowAlertsCommand}" />
            <Button MinWidth="64" Margin="6,0,0,0" Content="Logo" Command="{Binding ShowLogoCommand}" />
            <Button MinWidth="64" Margin="6,0,0,0" Content="Black" Command="{Binding BlackOutputCommand}" />
            <Button MinWidth="64" Margin="6,0,0,0" Content="Clear" Command="{Binding ClearOutputCommand}" />
            <TextBlock Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="{Binding PreviewTitle}" />
          </StackPanel>

          <Border DockPanel.Dock="Bottom"
                  Height="190"
                  Margin="0,8,0,0"
                  Background="#1D2026"
                  CornerRadius="2">
            <Grid>
              <ScrollViewer Margin="12,32,12,12" VerticalScrollBarVisibility="Auto">
                <TextBlock Foreground="#E6E8EB"
                           FontSize="15"
                           Text="{Binding PreviewText}"
                           TextWrapping="Wrap" />
              </ScrollViewer>
              <Border HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="8"
                      Background="#33000000"
                      Padding="6,2">
                <TextBlock Foreground="#E6E8EB" Text="{Binding PreviewTitle}" />
              </Border>
            </Grid>
          </Border>

          <TabControl>
            <TabItem Header="Songs">
              <ListBox ItemsSource="{Binding Songs}"
                       SelectedItem="{Binding SelectedSong}"
                       HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                      <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                 Text="{Binding Author, TargetNullValue=Unknown author}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
            <TabItem Header="Scriptures">
              <Grid>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="No translation selected" />
              </Grid>
            </TabItem>
            <TabItem Header="Media">
              <ListBox ItemsSource="{Binding Media}"
                       SelectedItem="{Binding SelectedMedia}"
                       HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,3">
                      <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Foreground="{StaticResource MutedTextBrush}">
                        <Run Text="{Binding Width}" />
                        <Run Text=" x " />
                        <Run Text="{Binding Height}" />
                        <Run Text=" | status " />
                        <Run Text="{Binding Status}" />
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
            <TabItem Header="Presentations">
              <ListBox ItemsSource="{Binding Presentations}"
                       SelectedItem="{Binding SelectedPresentation}"
                       HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                      <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                 Text="{Binding Slides.Count, StringFormat={}{0} slide(s)}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
            <TabItem Header="Themes">
              <ListBox ItemsSource="{Binding Themes}"
                       SelectedItem="{Binding SelectedTheme}"
                       HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                      <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                 Text="{Binding SourcePath}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
            <TabItem Header="Settings">
              <ListBox ItemsSource="{Binding Settings}"
                       HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,3">
                      <TextBlock FontWeight="SemiBold"
                                 Text="{Binding Key}"
                                 TextWrapping="Wrap" />
                      <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                 Text="{Binding Value}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Border>

      <Border Grid.Column="2"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Text="Live Output" />
          <Border Margin="0,8,0,0"
                  Background="{StaticResource OutputBrush}"
                  CornerRadius="2">
            <Grid>
              <TextBlock Margin="16"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="#E6E8EB"
                         FontSize="16"
                         Text="{Binding LiveText}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
              <TextBlock Margin="8"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Foreground="#A8ADB8"
                         Text="{Binding LiveTitle}" />
              <TextBlock Margin="8"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Foreground="#A8ADB8"
                         Text="{Binding OutputStatus}" />
            </Grid>
          </Border>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
